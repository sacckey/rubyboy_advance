#!/usr/bin/env ruby
# frozen_string_literal: true

require 'rubyboy_advance'
require 'rubyboy_advance/lcd'

abort "Usage: #{File.basename($PROGRAM_NAME)} BIOS_PATH ROM_PATH" unless ARGV.size == 2

bios = File.binread(ARGV[0]).bytes
abort 'BIOS_PATH must be a 16 KB GBA BIOS dump' unless bios.size == 0x4000
rom = File.binread(ARGV[1]).bytes
cartram =
  case rom.pack('C*')
  when /EEPROM_V/ then RubyboyAdvance::Eeprom.new
  when /FLASH1M_V/ then RubyboyAdvance::Flash128.new
  when /FLASH\w*_V/ then RubyboyAdvance::Flash.new
  else RubyboyAdvance::Sram.new
  end
interrupt = RubyboyAdvance::Interrupt.new
ppu = RubyboyAdvance::Ppu.new(interrupt)
timer = RubyboyAdvance::Timer.new(interrupt)
keypad = RubyboyAdvance::Keypad.new(interrupt)
bus = RubyboyAdvance::Bus.new(rom, bios, ppu, cartram, interrupt, timer, keypad)
cpu = RubyboyAdvance::Cpu.new(bus)
lcd = RubyboyAdvance::Lcd.new
begin
  loop do
    cycles = cpu.exec
    timer.step(cycles)
    next unless ppu.step(cycles) { |timing| bus.run_dma(timing) }

    lcd.draw(ppu.buffer)
    break if lcd.window_should_close?

    keypad.update(lcd.pressed_keys)
  end
rescue RuntimeError => e
  abort e.message
ensure
  lcd.close
end
