#!/usr/bin/env ruby
# frozen_string_literal: true

require 'rubyboy_advance'
require 'rubyboy_advance/lcd'

abort "Usage: #{File.basename($PROGRAM_NAME)} ROM_PATH" unless ARGV.size == 1

rom = File.binread(ARGV[0]).bytes
ppu = RubyboyAdvance::Ppu.new
cartram = rom.pack('C*').match?(/FLASH\w*_V/) ? RubyboyAdvance::Flash.new : RubyboyAdvance::Sram.new
cpu = RubyboyAdvance::Cpu.new(RubyboyAdvance::Bus.new(rom, ppu, cartram))
lcd = RubyboyAdvance::Lcd.new
begin
  loop do
    next unless ppu.step(cpu.exec)

    lcd.draw(ppu.buffer)
    break if lcd.window_should_close?
  end
rescue RuntimeError => e
  abort e.message
ensure
  lcd.close
end
