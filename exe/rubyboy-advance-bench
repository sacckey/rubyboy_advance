#!/usr/bin/env ruby
# frozen_string_literal: true

require 'rubyboy_advance'
require 'optparse'

# Builds what exe/rubyboy-advance runs, without the window, the keys and the audio device.
# Returns the PPU and a lambda that runs one frame
def build(bios, rom)
  cartram =
    case rom
    when /EEPROM_V/ then RubyboyAdvance::Eeprom.new
    when /FLASH1M_V/ then RubyboyAdvance::Flash128.new
    when /FLASH\w*_V/ then RubyboyAdvance::Flash.new
    else RubyboyAdvance::Sram.new
    end
  interrupt = RubyboyAdvance::Interrupt.new
  ppu = RubyboyAdvance::Ppu.new(interrupt)
  timer = RubyboyAdvance::Timer.new(interrupt)
  apu = RubyboyAdvance::Apu.new
  bus = RubyboyAdvance::Bus.new(rom.bytes, bios.bytes, ppu, cartram, interrupt, timer, RubyboyAdvance::Keypad.new(interrupt), apu)
  cpu = RubyboyAdvance::Cpu.new(bus)
  frame = lambda do
    loop do
      cycles = cpu.exec
      timer.step(cycles) { |id| apu.timer_overflow(id) { |timing| bus.run_dma(timing) } }
      apu.step(cycles)
      break if ppu.step(cycles) { |timing| bus.run_dma(timing) }
    end
    apu.take_samples
  end
  [ppu, frame]
end

options = { count: 3, frames: 600, warmup_frames: 0 }
parser = OptionParser.new do |opts|
  opts.banner = "Usage: #{File.basename($PROGRAM_NAME)} --bios-path BIOS_PATH --rom-path ROM_PATH [options]"
  opts.on('--bios-path BIOS_PATH', String, 'Path to the 16 KB GBA BIOS dump (required)') { |path| options[:bios_path] = path }
  opts.on('--rom-path ROM_PATH', String, 'Path to the ROM file (required)') { |path| options[:rom_path] = path }
  opts.on('--count COUNT', Integer, 'Number of trials (default: 3)') { |count| options[:count] = count }
  opts.on('--frames FRAMES', Integer, 'Measured frames per trial (default: 600)') { |frames| options[:frames] = frames }
  opts.on('--warmup-frames FRAMES', Integer, 'Unmeasured frames before each trial (default: 0)') { |frames| options[:warmup_frames] = frames }
end
begin
  parser.parse!
rescue OptionParser::ParseError => e
  abort "#{e.message}\n#{parser.banner}"
end
abort parser.help unless options[:bios_path] && options[:rom_path] && ARGV.empty?
abort '--count and --frames must be at least 1' unless options[:count] >= 1 && options[:frames] >= 1
abort '--warmup-frames must not be negative' if options[:warmup_frames] < 0

bios = File.binread(options[:bios_path])
abort '--bios-path must be a 16 KB GBA BIOS dump' unless bios.bytesize == 0x4000
rom = File.binread(options[:rom_path])

puts "Ruby: #{RUBY_VERSION}"
puts "YJIT: #{defined?(RubyVM::YJIT) ? RubyVM::YJIT.enabled? : false}"

total = 0.0
checksum = 0
options[:count].times do |i|
  ppu, frame = build(bios, rom)
  options[:warmup_frames].times { frame.call }
  start = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  options[:frames].times { frame.call }
  time = Process.clock_gettime(Process::CLOCK_MONOTONIC) - start
  puts "#{i + 1}: #{time} sec"

  total += time
  # Every trial ends on the same frame, so a change that alters this value has changed what is emulated
  checksum = ppu.buffer.reduce(0) { |hash, pixel| ((hash * 31) + pixel) & 0xFFFF_FFFF }
end

puts "FPS: #{options[:frames] * options[:count] / total}"
puts "Checksum: #{checksum}"
